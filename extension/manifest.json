{
  "manifest_version": 3,
  "name": "Video Flow Render Bridge",
  "version": "0.1.1",
  "description": "Cầu nối giữa app Video Flow Render và trình duyệt đã đăng nhập (TikTok, Douyin, Xiaohongshu).",
  "permissions": ["tabs", "cookies", "storage", "alarms"],
  "host_permissions": [
    "*://*.tiktok.com/*", "*://*.douyin.com/*", "*://*.xiaohongshu.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*", "*://*.douyin.com/*", "*://*.xiaohongshu.com/*"],
      "js": ["adapters/common.js", "adapters/douyin.js", "adapters/tiktok.js", "adapters/xhs.js", "inject.js"],
      "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["*://*.tiktok.com/*", "*://*.douyin.com/*", "*://*.xiaohongshu.com/*"],
      "js": ["adapters/common.js", "adapters/douyin.js", "adapters/tiktok.js", "adapters/xhs.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
